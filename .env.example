# massCode Server Configuration
# Copy to .env and adjust as needed

# API server port (internal, proxied by nginx on port 8080)
MASSCODE_PORT=4321

# Path where SQLite database and assets are stored
MASSCODE_STORAGE_PATH=/data

# Path for database backups
MASSCODE_BACKUP_PATH=/data/backups

# API authentication token (leave empty to disable auth)
# Set this for any network-exposed deployment
MASSCODE_API_TOKEN=

# Auto-backup settings
MASSCODE_BACKUP_ENABLED=true
MASSCODE_BACKUP_INTERVAL=6
MASSCODE_MAX_BACKUPS=5

# CORS origin (default: allow all)
MASSCODE_CORS_ORIGIN=*
